{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci --no-audit --no-fund",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/templates",
      "destination": "/"
    },
    {
      "source": "/templates/:slug",
      "destination": "/"
    },
    {
      "source": "/i/:slug",
      "destination": "/"
    }
  ]
}
