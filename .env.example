# Kredensial Supabase yang aman digunakan di browser.
# Isi dengan project lokal, staging, atau production sesuai environment.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Hanya untuk kompatibilitas proyek lama. Utamakan publishable key.
VITE_SUPABASE_ANON_KEY=
VITE_APP_BASE_URL=http://localhost:5173

# Kredensial server. Jangan gunakan prefix VITE_ dan jangan kirim ke browser.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false
